# Copy to .env and adjust. Nothing here is required for offline/default operation.

# SQLite database file path (relative to repo root)
DATABASE_URL=sqlite:///./data/copilot.db

# Directory containing synthetic scenario JSON files
SCENARIOS_DIR=./data/scenarios

# LLM explanation layer: "mock" (default, offline, deterministic) or "openai_compatible" (opt-in)
LLM_MODE=mock

# Only read when LLM_MODE=openai_compatible. Never commit a real key.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# App/API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
